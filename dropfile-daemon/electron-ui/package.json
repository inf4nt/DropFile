{
  "name": "dropfile-ui",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.dropfile.ui",
    "forceCodeSigning": false,
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "directories": {
      "output": "dist"
    }
  }
}